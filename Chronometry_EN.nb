Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertDateTo", "[", 
   RowBox[{"date_", ",", "DavidianJovian"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ed", "}"}], ",", " ", 
    RowBox[{
     RowBox[{"ed", " ", "=", " ", 
      RowBox[{"DayNumber", "[", "date", "]"}]}], ";", " ", 
     RowBox[{"ed", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ed", "-", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"ed", "+", 
          RowBox[{"DaysRemaining", "[", "date", "]"}]}], ")"}]}], "+", 
       RowBox[{"date", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"DavidianJovinian", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ed", "+", "10000"}], ")"}], "*", "365.26"}], ")"}], "/", 
       "4331.572"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5858150176343966`*^9, 3.585815037274831*^9}, {
  3.585815476899203*^9, 
  3.585815486165619*^9}},ExpressionUUID->"16b9aaf9-6fd8-46bc-9096-\
ad6fca20efac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertDateTo", "[", 
   RowBox[{
    RowBox[{"DavidianJovian", "[", "jd_", "]"}], ",", "Gregorian"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ed", ",", " ", "j"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"ed", " ", "=", " ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"jd", "*", "4331.572"}], ")"}], "/", "365.26"}], ")"}], 
         "-", "10000"}], ",", " ", "20"}], "]"}]}], ";", " ", 
     RowBox[{"j", " ", "=", " ", 
      RowBox[{"Floor", "[", "ed", "]"}]}], ";", "  ", 
     RowBox[{"ed", " ", "=", " ", 
      RowBox[{"ed", " ", "-", " ", "j"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"ed", " ", "=", " ", 
      RowBox[{"Floor", "[", 
       RowBox[{"ed", "*", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"DaysRemaining", "[", 
           RowBox[{"Gregorian", "[", 
            RowBox[{"j", ",", "1", ",", "1"}], "]"}], "]"}], "+", "1"}], 
         ")"}]}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"DaysPlusC", "[", 
      RowBox[{
       RowBox[{"Gregorian", "[", 
        RowBox[{"j", ",", "1", ",", "1"}], "]"}], ",", " ", "ed"}], "]"}]}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.5858143609668427`*^9, 3.585814432118568*^9}, {
