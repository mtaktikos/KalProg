    RowBox[{"-", "0.009689232473039173`"}]}], ",", 
   RowBox[{"Distance", "\[Rule]", 
    RowBox[{"0.9879394131772739`", " ", "AU"}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.601554134935077*^9},ExpressionUUID->"31d454c7-a877-4e46-9db0-\
d944c830f00f"]
}, Open  ]],

