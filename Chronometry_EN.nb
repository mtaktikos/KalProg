Cell[TextData[{
 "The default ",
 StyleBox["ViewPoint",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " is the centre of the ",
 StyleBox["Earth",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", but you can specify any other object. The special symbol ",
 StyleBox["TopoCentric",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " can be used to specify the point on the surface of the ",
 StyleBox["Earth",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " where you previously set your location."
}], "Text",
