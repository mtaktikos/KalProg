Cell["\<\
In welchem Jahr/welchen Jahren fiel der 1. Mai eines julianischen Datums auf \
Samstag, wobei an diesem Hexensabbat schon oder noch das Licht eines \
naheliegenden Vollmonds sichtbar war?\
\>", "Text",ExpressionUUID->"83caa211-1aa9-468a-9980-7ce8c69b545e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"akt", ",", "ang", ",", "d", ",", 
     RowBox[{"erg", "=", 
      RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"DayOfWeekC", "[", 
         RowBox[{"Julian", "[", 
          RowBox[{"jahr", ",", "5", ",", "1"}], "]"}], "]"}], "\[Equal]", 
        "\"\<Saturday\>\""}], ",", 
       RowBox[{
        RowBox[{"akt", "=", 
         RowBox[{"Julian", "[", 
          RowBox[{"jahr", ",", "5", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d", "=", 
         RowBox[{"ToFixed", "[", "akt", "]"}]}], ";", 
        RowBox[{"ang", "=", 
         RowBox[{"LunarPhase", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"180", "-", "ang"}], "]"}], "<", "3"}], ",", 
          RowBox[{"Print", "[", "jahr", "]"}]}], "]"}]}]}], " ", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"jahr", ",", 
       RowBox[{"-", "30"}], ",", "2100"}], "}"}]}], "]"}]}], "]"}]], "Input",
