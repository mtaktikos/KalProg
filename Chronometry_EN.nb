Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "LunarPhase"}]], "Input",
 CellChangeTimes->{{3.416424522203125*^9, 
  3.41642452528125*^9}},ExpressionUUID->"a1c9270e-992c-41ed-9158-\
b5a7bb313e97"],

Cell[BoxData[
 StyleBox["\<\"LunarPhase[tee] gives the lunar phase, as an angle \
in\\ndegrees, at moment $tee$. An angle of 0 means a new moon, 90 degrees \
means the\\nfirst quarter, 180 means a full moon, and 270 degrees means the \
last quarter.\"\>", "MSG"]], "Print", "PrintUsage",
 CellChangeTimes->{3.416424525859375*^9},
 CellTags->
  "Info3416431725-2065539",ExpressionUUID->"4099c1fb-9fee-4a43-9f64-\
71084c7a6157"]
}, Open  ]],

Cell["Wann fiel der Herbstequinox auf Vollmond?", "Text",
 CellChangeTimes->{{3.607082569364984*^9, 3.6070825793802013`*^9}, {
  3.939641775640997*^9, 3.9396417866920166`*^9}, {3.939641959543764*^9, 
  3.9396419658843822`*^9}},
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"b9f252d2-0fd7-4435-bbfe-a235e7a3a4ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", ",", "test", ",", "t", ",", "sl", ",", "ang", ",", "g", ",", 
     RowBox[{"erg", "=", 
      RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"ToFixed", "[", 
         RowBox[{"Gregorian", "[", 
          RowBox[{"j", ",", "9", ",", "17"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"test", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"d", "+", "t"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "8", ",", "1"}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"sl", "=", 
        RowBox[{"First", "[", 
         RowBox[{"MinimalBy", "[", 
          RowBox[{"test", ",", 
           RowBox[{
            RowBox[{"SolarLongitudeC", "[", "#", "]"}], "&"}]}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ang", "=", 
        RowBox[{"LunarPhase", "[", "sl", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"180", "-", "ang"}], "]"}], "<", "1"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"g", "=", 
           RowBox[{"Gregorian", "[", "sl", "]"}]}], ";", 
          RowBox[{"Print", "[", "g", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"erg", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"erg", ",", "g"}], "]"}]}]}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"-", "6000"}], ",", 
        RowBox[{"-", "500"}]}], "}"}]}], "]"}], ";", "erg"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9391276566052704`*^9, 3.9391277465794487`*^9}, {
  3.9391278628243027`*^9, 3.9391279459740696`*^9}, {3.9396419551175137`*^9, 
  3.939641956053257*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"9f1c7ff3-00c1-b045-9240-f94f72ff7b06"],

Cell[BoxData[
 InterpretationBox["\<\"Wednesday, \\!\\(\\*RowBox[{\\\"17\\\"}]\\) September \
