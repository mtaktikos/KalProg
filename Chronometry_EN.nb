Cell["8.4. Relativistic Time Effects", "Subsection",ExpressionUUID->"473e699f-3f37-4a79-a30a-38f5a670a246"],

Cell["\<\
Durch Einsteins Spezielle Relativit\[ADoubleDot]tstheorie konnte gezeigt \
werden, da\[SZ] die Zeit keine absolute Gr\[ODoubleDot]\[SZ]e ist: je h\
\[ODoubleDot]her die Geschwindigkeit des beobachteten Inertialsystems, desto \
langsamer altert es relativ zum Beobachter. Diese Zeitdilatation kann durch \
die Formel von Lorentz exakt berechnet werden:\
\>", "Text",ExpressionUUID->"771b65eb-a556-443d-a17b-bffa8951b714"],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"c0", "=", " ", 
     RowBox[{"299792.4562", "*", "1000", " ", 
      RowBox[{"Meter", "/", "Second"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"die", " ", "Lichtgeschwindigkeit"}], " ", "*)"}]}],
  FormatType->StandardForm,
  FontFamily->"Courier New"], "\n", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"t0", "=", " ", 
     RowBox[{"1", " ", "Hour"}]}], ";"}], " ", 
   StyleBox[
    RowBox[{"(*", " ", 
     RowBox[{
     "dies", " ", "sei", " ", "die", " ", "Me\[SZ]dauer", " ", "des", " ", 
      "Beobachters"}], " ", "*)"}],
    FontSize->10]}],
  FormatType->StandardForm,
  FontFamily->"Courier New"], "\n", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"trel", "[", "v_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"t0", "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"v", "/", "c"}], ")"}], "^", "2"}]}], "]"}]}], " ", "/.", 
     " ", 
     RowBox[{"c", " ", ":>", " ", "c0"}]}]}], "  ", "\n", 
   StyleBox[
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"die", " ", "Zeit"}], ",", " ", 
      RowBox[{
      "die", " ", "w\[ADoubleDot]hrend", " ", "der", " ", "Me\[SZ]dauer", " ",
        "f\[UDoubleDot]r", " ", "das", " ", "beobachtete", " ", "Objekt", " ",
        "vergeht"}]}], " ", "*)"}],
    FontSize->10]}],
  FormatType->StandardForm,
  FontFamily->"Courier New"], "\n", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"v1", " ", "=", " ", 
     RowBox[{"0.25", "*", "1000", " ", 
      RowBox[{"Meter", "/", "Second"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Reise", " ", "im", " ", "Jet"}], " ", "*)"}]}],
  FormatType->StandardForm,
  FontFamily->"Courier New"], "\n", 
 StyleBox[
  RowBox[{"trel", "[", "v1", "]"}],
  FormatType->StandardForm,
  FontFamily->"Courier New"]}], "Input",ExpressionUUID->"9429e9c2-1770-4806-\
aefd-12d1ffb0718f"],

Cell[BoxData[
 StyleBox[
  RowBox[{"1.", " ", "Hour"}],
  FormatType->StandardForm,
  FontSize->10]], "Output",ExpressionUUID->"e42f327e-5928-4b89-bb7f-\
b83eff046023"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   StyleBox[
    RowBox[{"(*", " ", 
