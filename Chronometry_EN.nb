Cell[TextData[{
 StyleBox["7.1.6. The ",
  FontVariations->{"Underline"->True}],
 StyleBox["Separation",
  FontFamily->"Courier",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox[" command ",
  FontVariations->{"Underline"->True}],
 "\nThis is useful for determining Conjunctions, Eclipses and Transits etc."
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"29dbdd80-bc17-47d5-9cc0-abf14496ac10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\"\<Separation\>\"", ",", 
   RowBox[{"LongForm", "\[Rule]", "False"}]}], "]"}]], "Input",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"b5fd29f5-ca63-4e14-ab27-dc766bd8e450"],

Cell[BoxData[
 StyleBox["\<\"Separation[object1, object2, date] returns the angular \
separation of the two objects (which may be planets, Sun, Moon, asteroids or \
stars etc) on the given date. If date is omitted the current Date[] is used. \
And if only one object is given, then the other object is assumed to be the \
Sun.\"\>", "MSG"]], "Print", "PrintUsage",
 CellChangeTimes->{3.601554298516965*^9},
 CellTags->
  "Info3601557898-3591912",ExpressionUUID->"7cacdcde-bd6a-41eb-87cd-\
5389cec7f806"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox["Separation",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " command can be applied to objects like ",
 StyleBox["Mars",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Moon",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Io",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " (solar system objects), ",
 StyleBox["Sirius",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Alpha.Centaurus",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " (stars), ",
 StyleBox["Leo",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["UrsaMajor",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " (constellations), ",
 StyleBox["SouthCelestialPole",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Zenith",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " (special objects) etc."
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"2be8d525-48a5-4749-96e0-b6b92639262e"],

