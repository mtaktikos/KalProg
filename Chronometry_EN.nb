Cell["\<\
Unsere Algorithmen geben die Ergebnisse in Weltzeit (UTC) wieder, die wegen \
der sich unregelm\[ADoubleDot]ssig verlangsamenden Erdrotation keine gleicm\
\[ADoubleDot]ssige Gr\[ODoubleDot]sse ist. Der Abstand zur dynamischen \
Zeit(TD) heisst \[DifferenceDelta]T: UTC = TD - \[DifferenceDelta]T
Folgende Funktion gibt zu einer UTC Zeit das DeltaT wieder:\
\>", "Text",
 CellChangeTimes->{{3.9395715398140316`*^9, 3.9395717444791927`*^9}, {
  3.939571783633564*^9, 3.93957193769215*^9}, {3.9395742932026997`*^9, 
  3.939574348813135*^9}},ExpressionUUID->"60a103d9-e9a6-3144-9d82-\
c44b816805d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DeltaT", "[", "utc_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"datum", ",", "uhrzeit", ",", "weltzeit", ",", "dynzeit"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"datum", "=", 
      RowBox[{"ToFixed", "[", 
       RowBox[{"utc", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", " ", 
     RowBox[{"uhrzeit", "=", 
      RowBox[{
       RowBox[{"ggg", "[", 
        RowBox[{"utc", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "/", "24"}]}], ";", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"weltzeit", "=", 
      RowBox[{"datum", "+", "uhrzeit"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dynzeit", "=", 
      RowBox[{"DynamicalFromUniversal", "[", "weltzeit", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"DecimalForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"dynzeit", "-", "weltzeit"}], ")"}], "*", "24", "*", 
         "3600"}], ",", "20"}], "]"}], "*", "Seconds"}]}]}], "]"}]}]], "Input",\
ExpressionUUID->"bd759cd9-1083-d44b-bd5d-aafd88b1e016"],

