    RowBox[{"1993", ",", "11", ",", "17", ",", "3", ",", "20", ",", "0"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"b8a591ce-3c76-466e-8b2c-\
f11c95214f48"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Ascension", "\[Rule]", 
    RowBox[{"14.652163191302098`", " ", "Hour"}]}], ",", 
   RowBox[{"Declination", "\[Rule]", 
    RowBox[{"-", "1.0612276030773902`"}]}], ",", 
   RowBox[{"Distance", "\[Rule]", "\[Infinity]"}]}], "}"}]], "Output",
