Cell[TextData[{
 "Here's a plot of the separation of the ",
 StyleBox["Moon",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " and the ",
 StyleBox["Sun",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " during the month of November in 1994. If the separation is less than about \
half a degree, then that will be a partial Solar Eclipse."
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"6e364ff7-5205-4ea4-aab3-0774c668c11b"],

