Cell["\<\
Daher lesen wir fertig errechnete Daten durch Espenak ein, wo sogar die \
Uhrzeit der engsten Konjunktion mit angegeben ist:\
\>", "Text",ExpressionUUID->"ab383d77-4043-cc4c-b014-24aeb37bb56f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"str", "=", 
   RowBox[{
   "OpenRead", "[", 
    "\"\<c:\\\\Mma14\\\\AddOns\\\\Applications\\\\Astronomy\\\\venustransits.\
txt\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sucheBisJahr", "=", 
   RowBox[{"-", "1500"}]}], ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"basis", ",", "year", ",", 
     RowBox[{"mona", "=", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Jan\>\"", ",", "\"\<Feb\>\"", ",", "\"\<Mar\>\"", ",", 
        "\"\<Apr\>\"", ",", "\"\<May\>\"", ",", "\"\<Jun\>\"", ",", 
        "\"\<Jul\>\"", ",", "\"\<Aug\>\"", ",", "\"\<Sep\>\"", ",", 
        "\"\<Oct\>\"", ",", "\"\<Nov\>\"", ",", "\"\<Dec\>\""}], "}"}]}], ",",
      "month", ",", "day", ",", "hr", ",", "min", ",", 
     RowBox[{"erg", "=", 
      RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"basis", "=", 
        RowBox[{"ReadLine", "[", "str", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"year", " ", "=", " ", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringTake", "[", 
          RowBox[{"basis", ",", "6"}], "]"}], "]"}]}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"year", "<", "0"}], ",", 
         RowBox[{"year", "=", 
          RowBox[{"year", "-", "1"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", " ", 
        RowBox[{
         RowBox[{"year", " ", ">", " ", "sucheBisJahr"}], ",", 
         RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"month", " ", "=", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"mona", ",", 
           RowBox[{"StringTake", "[", 
            RowBox[{"basis", ",", 
             RowBox[{"{", 
              RowBox[{"8", ",", "10"}], "}"}]}], "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"day", "=", " ", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringTake", "[", 
          RowBox[{"basis", ",", 
           RowBox[{"{", 
            RowBox[{"12", ",", "13"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hr", "=", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringTake", "[", 
          RowBox[{"basis", ",", 
           RowBox[{"{", 
            RowBox[{"33", ",", "34"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"min", "=", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringTake", "[", 
          RowBox[{"basis", ",", 
           RowBox[{"{", 
            RowBox[{"36", ",", "37"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"year", "<", "1583"}], ",", 
         RowBox[{"erg", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"erg", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Julian", "[", 
               RowBox[{"year", ",", "month", ",", "day"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"hr", ",", "min", ",", "0"}], "}"}]}], "}"}]}], 
           "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"erg", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"erg", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Gregorian", "[", 
               RowBox[{"year", ",", "month", ",", "day"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"hr", ",", "min", ",", "0"}], "}"}]}], "}"}]}], 
           "]"}]}]}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "83"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Close", "[", "str", "]"}], ";", "\[IndentingNewLine]", "erg"}]}],
   "]"}]}], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"30919ac2-612f-3442-984c-318bd24264b5"],

