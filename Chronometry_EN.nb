Cell[TextData[{
 "Here's a plot of the position of ",
 StyleBox["Mars",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " during a two year period centred on 1986. The motion is mostly right to \
left, but note the ",
 StyleBox["retrograde",
  FontVariations->{"Underline"->True}],
 " motion."
}], "Text",
 ImageRegion->{{0., 1.}, {0., 
  1.}},ExpressionUUID->"bf205caf-92ff-4472-978a-2dfc91d7fb4a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Ascension", "/", "Hour"}], "*", "15"}], ",", " ", 
        RowBox[{"Declination", "/", "Degree"}]}], "}"}], " ", "/.", "\n", 
      "     ", 
      RowBox[{"EquatorCoordinates", "[", 
       RowBox[{"Mars", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1986", ",", "1", ",", "day", ",", "0", ",", "0", ",", "0"}],
          "}"}], ",", "\n", "                        ", 
        RowBox[{"ViewPoint", " ", "->", " ", "Earth"}]}], "]"}]}], ",", "\n", 
     "        ", 
     RowBox[{"{", 
      RowBox[{"day", ",", " ", 
       RowBox[{"-", "300"}], ",", " ", "350", ",", " ", "30"}], "}"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"PlotRange", "   ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "360"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "30"}], ",", " ", "30"}], "}"}]}], "}"}]}], ",", "\n", 
   "  ", 
