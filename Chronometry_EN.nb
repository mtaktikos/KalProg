Cell["\<\
Auf die Funktion FullMoonQ k\[ODoubleDot]nnen wir nicht verzichten. \
Approximieren wir dies durch oppositionQ, wird die Ausgabe \
unpr\[ADoubleDot]zise:\
\>", "Text",
 CellChangeTimes->{{3.6017338798921003`*^9, 
  3.601733943353012*^9}},ExpressionUUID->"40492266-a4c1-4695-a796-\
789b77fea9d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{
    RowBox[{"aktday", "=", " ", 
     RowBox[{"Gregorian", "[", 
      RowBox[{"2004", ",", "12", ",", "31"}], "]"}]}], ";", " ", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"aktday", "=", 
        RowBox[{"DaysPlusC", "[", 
         RowBox[{"aktday", ",", " ", "1"}], "]"}]}], ";", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"partielleConjQ", "[", 
           RowBox[{"Jupiter", ",", " ", "Sun", ",", " ", "aktday"}], "]"}], 
          " ", "&&", " ", 
          RowBox[{"trineQ", "[", 
           RowBox[{"Saturn", ",", " ", "Sun", ",", " ", "aktday"}], "]"}], 
          " ", "&&", " ", 
          RowBox[{"oppositionQ", "[", 
           RowBox[{"Moon", ",", " ", "Sun", ",", " ", "aktday"}], "]"}]}], 
         ",", " ", 
         RowBox[{"Print", "[", "aktday", "]"}]}], "]"}]}], ",", " ", 
      RowBox[{"{", "5500", "}"}]}], "]"}]}]}], "]"}]], "Input",
