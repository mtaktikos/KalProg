}, Open  ]],

Cell["2.2. The Julian Calendar", "Subsection",ExpressionUUID->"c75baba3-fd6b-3441-975a-f47c9296606a"],

Cell["\<\
Das Julianische year war um 0.0078 days (11 m, 14 s) l\[ADoubleDot]nger als \
das (fast konstante) tropische. Das hie\[SZ], da\[SZ] Tagundnachgleichen and \
Sonnenwenden bei sich allm\[ADoubleDot]hlich akkumulierenden Fehlern auf fr\
\[UDoubleDot]here days fielen. Ungef\[ADoubleDot]hr beim Konzil von Niz\
\[ADoubleDot]a (325 C.E.) mu\[SZ] der Fr\[UDoubleDot]hlingsequinox auf den \
21.M\[ADoubleDot]rz gefallen sein.
Wie weit hatte sich die Fr\[UDoubleDot]hlingsequinoxverschiebung von C\
\[ADoubleDot]sar (Einf\[UDoubleDot]hrung -46 B.C.E.) bis 1582 C.E. \
akkumuliert?\
\>", "Text",
 CellChangeTimes->{{3.941259637799734*^9, 3.9412596378564987`*^9}, {
  3.941259758229254*^9, 
  3.941259758286867*^9}},ExpressionUUID->"2770ed03-9682-49eb-a540-\
13d0e839253b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", 
       RowBox[{"-", "46"}]}], 
      RowBox[{"-", "1"}]], 
     RowBox[{"(", 
      RowBox[{"365.25", "-", 
       RowBox[{"tropJahr", "[", "i", "]"}]}], ")"}]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "1582"], 
     RowBox[{"(", 
      RowBox[{"365.25", "-", 
       RowBox[{"tropJahr", "[", "i", "]"}]}], ")"}]}]}], ",", "10"}], 
  "]"}]], "Input",
 PageWidth->Infinity,
 CellChangeTimes->{{3.4179732302316675`*^9, 3.4179732407316675`*^9}, 
   3.4179732909660425`*^9},
 ImageRegion->{{0, 1}, {0, 1}},
 FontFamily->
  "Courier New",ExpressionUUID->"beb0f08a-3abd-4bda-9dc5-76482a0655de"],

Cell[BoxData["12.587263220840782`"], "Output",ExpressionUUID->"6c9e149a-25c5-4f90-81f0-cf5b001a9f78"]
}, Open  ]],

