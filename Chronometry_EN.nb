Cell[BoxData[{
 RowBox[{
  RowBox[{"first", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"akt", "=", 
   RowBox[{"Gregorian", "[", 
    RowBox[{"2003", ",", "12", ",", "31"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"akt", "=", 
      RowBox[{"DaysPlusC", "[", 
       RowBox[{"akt", ",", "1"}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"DD", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"akt", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "DD", "]"}], "<", "2"}], ",", 
