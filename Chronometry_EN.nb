Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"date", "=", 
     RowBox[{"Gregorian", "[", 
      RowBox[{"j", ",", "5", ",", "1"}], "]"}]}], ";", 
    RowBox[{"dd", "=", 
     RowBox[{"DayOfWeekC", "[", "date", "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"FullmoonQ", "[", "date", "]"}], " ", "&&", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"dd", "==", "\"\<Saturday\>\""}], ")"}], " ", "||", " ", 
         RowBox[{"(", 
          RowBox[{"dd", "\[Equal]", "\"\<Friday\>\""}], ")"}]}], ")"}]}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"dd", ",", "\"\<, \>\"", ",", "date"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "1583", ",", "2100"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.9319483456602793`*^9},ExpressionUUID->"4b8b9125-99be-47db-8e13-\
e2c75653b498"],

