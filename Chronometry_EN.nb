     ",", "\<\"9W\"\>", ",", "\<\"4m56s\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "3999"}], ",", "11", ",", "27", ",", "12", ",", "56", ",", 
     "3.0184217723144684`", ",", "\<\"P\"\>", ",", "\<\"70N\"\>", 
     ",", "\<\"140E\"\>", ",", "\<\"\"\>"}], "}"}]}], "}"}]], "Output",Express\
ionUUID->"704543ae-186d-4daf-b394-a216b2aadfb1"]
}, Open  ]],

Cell["\<\
Im Rigveda ist die Rede von einer Sonnenfinsternis drei days vor dem \
Herbstequinox. Hier die m\[ODoubleDot]glichen Daten:\
\>", "Text",ExpressionUUID->"12245270-e0cf-734e-b3f4-90eba9480ae1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"kandidaten", "=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"erg", "=", 
       RowBox[{"{", "}"}]}], ",", "akt"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"akt", "=", 
         RowBox[{"DaysPlusC", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EquiSol", "[", "i", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"-", "2"}]}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NewmoonQ", "[", "akt", "]"}], ",", 
          RowBox[{"erg", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"erg", ",", "akt"}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"-", "3999"}], ",", 
         RowBox[{"-", "3000"}]}], "}"}]}], "]"}], ";", "erg"}]}], 
   "]"}]}]], "Input",ExpressionUUID->"92144dc8-02ee-b440-9026-84428ed0cad8"],

