Cell["\<\
Ptolamaios meldete., im 17. year Hadrians (Julianisch 133) h\[ADoubleDot]tte \
am 1./2. Epiphi eine Opposition Sonne-Jupiter and am 18. Epiphi eine \
Opposition Sonne-Saturn stattgefunden\
\>", "Text",
 CellChangeTimes->{{3.6021599534149218`*^9, 3.6021600911319637`*^9}, {
  3.6021601328464375`*^9, 3.6021601984601526`*^9}, {3.6021607695147552`*^9, 
  3.6021607703415565`*^9}, {3.6021614209874997`*^9, 
  3.6021614242947054`*^9}},ExpressionUUID->"f77d02f0-02b1-49e5-a083-\
06c3f885be23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"datum", "=", 
     RowBox[{"ConvertDateTo", "[", 
      RowBox[{
       RowBox[{"Julian", "[", 
        RowBox[{"132", ",", "12", ",", "31"}], "]"}], ",", "Gregorian"}], 
      "]"}]}], "}"}], ",", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"datum", "=", 
       RowBox[{"DaysPlusC", "[", 
        RowBox[{"datum", ",", " ", "1"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"oppositionQ", "[", 
         RowBox[{"Sun", ",", " ", "Jupiter", ",", " ", "datum"}], "]"}], ",", 
        " ", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"ConvertDateTo", "[", 
          RowBox[{"datum", ",", "Julian"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", "365", "}"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.6021602168057847`*^9, 3.602160376347265*^9}, {
