Cell["\<\
Im years 1682 w\[ADoubleDot]re sogar eine (partielle) Konjunktion \
Mars-Jupiter-Saturn m\[ODoubleDot]glich:\
\>", "Text",ExpressionUUID->"2f49db62-6749-754c-868a-026e94393fcd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{
    RowBox[{"aktday", "=", " ", 
     RowBox[{"Gregorian", "[", 
      RowBox[{"1679", ",", "12", ",", "31"}], "]"}]}], ";", " ", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"aktday", "=", 
        RowBox[{"DaysPlusC", "[", 
         RowBox[{"aktday", ",", " ", "1"}], "]"}]}], ";", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"partielleConjQ", "[", 
           RowBox[{"Jupiter", ",", " ", "Saturn", ",", " ", "aktday"}], "]"}],
           " ", "&&", " ", 
          RowBox[{"totaleConjQ", "[", 
           RowBox[{"Jupiter", ",", " ", "Mars", ",", " ", "aktday"}], "]"}]}],
          ",", " ", 
         RowBox[{"Print", "[", "aktday", "]"}]}], "]"}]}], ",", 
      RowBox[{"{", "1500", "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[82]:=",ExpressionUUID->"d679bf1b-909c-eb42-886a-7a4fddf08695"],

