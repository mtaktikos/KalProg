Cell["\<\
Die Abst\[ADoubleDot]nde in Tagen zwischen den Transits beruhen auf Daten im \
astronomischen Format (Gregorian. Jahr, Julian. month and Tag)
Auch nach der Umwandlung in Julian kann das Programm nicht wissen, da\[SZ] \
das fixed Startdatum ein Gregorianisches year hatte, daher wird bei negativen \
Werten 1 abgezogen\
\>", "Text",ExpressionUUID->"545209b0-5ca2-174c-9655-6dacf24a1504"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "akt", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"akt", "=", 
       RowBox[{"Julian", "[", 
        RowBox[{"Floor", "[", 
         RowBox[{"vt", "[", "i", "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"akt", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "<", " ", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"vtransit", "[", "i", "]"}], "=", 
         RowBox[{"Julian", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"akt", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", 
           RowBox[{"akt", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"akt", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"vtransit", "[", "i", "]"}], "=", 
         RowBox[{"Julian", "[", 
          RowBox[{
           RowBox[{"akt", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"akt", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"akt", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "20"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"b9264a0f-4cb0-674a-94df-12fb6827e56e"],

Cell["\<\
Leider gen\[UDoubleDot]gt die Wahl fester Tagesabst\[ADoubleDot]nde zwischen \
Transits nicht f\[UDoubleDot]r eine ausreichend genaue Approximation, diese \
Abst\[ADoubleDot]nde variieren, vor allem in solchen Abst\[ADoubleDot]nden \
\[UDoubleDot]ber Jahrtausende:\
\>", "Text",ExpressionUUID->"2efd7f4e-0a80-bd42-a901-924d8f068ae8"],

