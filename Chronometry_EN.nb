      RowBox[{"Gregorian", "[", 
       RowBox[{"2009", ",", "8", ",", "6"}], "]"}], "]"}], ",", 
     RowBox[{"Jerusalem", "[", "]"}]}], "]"}], " ", "]"}],
  FormatType->StandardForm,
  FontFamily->"Courier New"]], "Input",ExpressionUUID->"89964a68-7f88-4144-\
