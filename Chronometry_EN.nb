Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"aktday", "=", 
      RowBox[{"Julian", "[", 
       RowBox[{
        RowBox[{"-", "2555"}], ",", "4", ",", "6"}], "]"}]}], ",", "greg"}], 
    "}"}], ",", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"greg", "=", " ", 
       RowBox[{"ConvertDateTo", "[", 
        RowBox[{"aktday", ",", "Gregorian"}], "]"}]}], ";", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"durchgangQ", "[", 
         RowBox[{"Mercury", ",", " ", "Sun", ",", " ", "greg"}], "]"}], ",", 
        " ", 
        RowBox[{
        "Print", "[", "\"\<Merkurdurchgang best\[ADoubleDot]tigt: \>\"", 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"aktday", ",", " ", "\"\< = gregorianisch \>\"", ",", "greg"}],
        " ", "]"}], ";", 
      RowBox[{"aktday", "=", " ", 
       RowBox[{"DaysPlusC", "[", 
        RowBox[{"aktday", ",", " ", "237780"}], "]"}]}], ";", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"i", ",", "2"}], "]"}], "\[Equal]", "0"}], ",", 
