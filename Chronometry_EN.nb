Cell["\<\
Kepler hat nach Jupiter-Saturn Konjunktionen gesucht, die in etwa alle 20 \
Jahre stattfinden, and kam auf die years 1583, 1603 etc. Hier ein \
Nachvollziehen der Berechnungen mit Startwerten jeweils ca 3 years fr\
\[UDoubleDot]her:\
\>", "Text",ExpressionUUID->"a72fbd82-6732-af4f-82a8-6919e3abc54f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{
    RowBox[{"aktday", "=", " ", 
     RowBox[{"Gregorian", "[", 
      RowBox[{"1579", ",", "12", ",", "31"}], "]"}]}], ";", " ", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"aktday", "=", 
        RowBox[{"DaysPlusC", "[", 
         RowBox[{"aktday", ",", " ", "1"}], "]"}]}], ";", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"totaleConjQ", "[", 
          RowBox[{"Jupiter", ",", " ", "Saturn", ",", " ", "aktday"}], "]"}], 
         ",", " ", 
         RowBox[{"Print", "[", "aktday", "]"}]}], "]"}]}], ",", 
      RowBox[{"{", "1500", "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[67]:=",ExpressionUUID->"631d635b-61e4-9f45-a853-dd48809eadb6"],

