Cell["2.1. Greek Calendars", "Subsection",ExpressionUUID->"4ba03cb5-62b8-478b-bdeb-4824e91439d8"],

Cell["\<\
Zur Analyse der griechischen Kalender brauchen wir die m\[ADoubleDot]chtige \
Funktion Separation, die den Winkelabstand zweier Himmelsk\[ODoubleDot]rper \
zu einem bel. Zeitpunkt angibt. Ein Abstand von 0\[Degree] w\[ADoubleDot]re \
eine Eclipse bzw ein Transit, eine von 180\[Degree] eine Opposition. Als Bsp \
errechnen wir die Separation Mars-Jupiter am 17.11.1993 um 03:20 Uhr:\
\>", "Text",ExpressionUUID->"4c361744-3d50-4a54-b56c-6d6f98258d35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Separation", "[", 
  RowBox[{"Mars", ",", "Jupiter", ",", 
   RowBox[{"{", 
    RowBox[{"1993", ",", "11", ",", "17", ",", "3", ",", "20", ",", "0"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"d194381a-5d6b-4972-abea-\
334ee40f41ee"],

Cell[BoxData["0.5960615382839661`"], "Output",
 CellChangeTimes->{
  3.9318841034099493`*^9},ExpressionUUID->"396498ac-5081-45cc-a1ff-\
b57e0d86e0e6"]
}, Open  ]],

