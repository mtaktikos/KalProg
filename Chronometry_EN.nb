Cell[TextData[{
 "To correct this to see that the ",
 StyleBox["Sun",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " is apparently at 0 degrees above the horizon, just apply ",
 StyleBox["Refract",
  FontFamily->"Courier",
  FontWeight->"Bold"]
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"45f267a4-114e-4eef-a19a-b618ba4164bf"],

