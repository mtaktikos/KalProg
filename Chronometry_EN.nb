Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"erg", "=", 
      RowBox[{"{", "}"}]}], ",", "akt", ",", "basis", ",", " ", "aktexp", ",",
      " ", "basisexp"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"akt", "=", 
        RowBox[{"pruef", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", 
       RowBox[{"aktexp", "=", " ", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringTake", "[", 
          RowBox[{"akt", ",", "5"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"basis", "=", 
        RowBox[{"ReadLine", "[", "str", "]"}]}], ";", 
       RowBox[{"basisexp", " ", "=", " ", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringTake", "[", 
          RowBox[{"basis", ",", "5"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"basisexp", " ", "<=", " ", "aktexp"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"basis", " ", "=", " ", 
           RowBox[{"ReadLine", "[", "str", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"basisexp", " ", "=", " ", 
           RowBox[{"ToExpression", "[", 
            RowBox[{"StringTake", "[", 
             RowBox[{"basis", ",", "5"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"StringTake", "[", 
               RowBox[{"basis", ",", "9"}], "]"}], "===", " ", "akt"}], " ", "&&",
              " ", 
             RowBox[{"StringContainsQ", "[", 
              RowBox[{"basis", ",", "\"\<T\>\""}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"erg", " ", "=", " ", 
             RowBox[{"Append", "[", 
              RowBox[{"erg", ",", " ", 
               RowBox[{"kandidaten", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], "]"}]}]}], 
        "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "pruef", "]"}]}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", "erg"}]}], "]"}]], "Input",ExpressionUUID->\
"6fa597c4-b311-074f-a14c-ccbd59883727"],

