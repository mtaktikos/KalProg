Cell[BoxData[
 RowBox[{
  RowBox[{"durchgangQ", "[", 
   RowBox[{"obj1_", ",", " ", "obj2_", ",", " ", 
    RowBox[{"Gregorian", "[", 
     RowBox[{"y_", ",", " ", "m_", ",", " ", "d_"}], "]"}]}], "]"}], ":=", 
  " ", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"erg", " ", "=", " ", "False"}], ",", "h", ",", " ", "sp1", ",",
       " ", "sp2", ",", " ", "eph"}], "}"}], ",", 
    RowBox[{
     RowBox[{"h", "=", "0"}], ";", 
     RowBox[{"sp1", "=", " ", 
      RowBox[{
       RowBox[{"Separation", "[", 
        RowBox[{"obj1", ",", " ", "obj2", ",", " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", "m", ",", "d"}], "}"}]}], "]"}], "/", 
       "Degree"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"sp2", "=", " ", 
      RowBox[{
       RowBox[{"Separation", "[", 
        RowBox[{"obj1", ",", " ", "obj2", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "y", ",", "m", ",", "d", ",", " ", "8", ",", "0", ",", "0"}], 
          "}"}]}], "]"}], "/", "Degree"}]}], ";", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sp2", " ", "<", " ", "sp1"}], ",", " ", 
       RowBox[{
        RowBox[{"sp1", " ", "=", " ", "sp2"}], ";", " ", 
        RowBox[{"h", "=", "8"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sp2", "=", " ", 
      RowBox[{
       RowBox[{"Separation", "[", 
        RowBox[{"obj1", ",", " ", "obj2", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "y", ",", "m", ",", "d", ",", " ", "16", ",", "0", ",", "0"}], 
          "}"}]}], "]"}], "/", "Degree"}]}], ";", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sp2", " ", "<", " ", "sp1"}], ",", " ", 
       RowBox[{
        RowBox[{"sp1", " ", "=", " ", "sp2"}], ";", " ", 
        RowBox[{"h", "=", "16"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sp1", " ", "<", " ", "2.0"}], ",", " ", 
       RowBox[{
        RowBox[{"eph", " ", "=", " ", 
         RowBox[{"Ephemeris", "[", 
          RowBox[{"Mercury", ",", " ", 
           RowBox[{"{", 
            RowBox[{"y", ",", "m", ",", "d", ",", "h", ",", "0", ",", "0"}], 
            "}"}]}], "]"}]}], ";", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", "[", "eph", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "<", " ", "0.002"}], ")"}],
            " ", "&&", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"eph", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "1"}], "]"}], "]"}], "]"}], " ", "<", " ", 
             "2"}], ")"}]}], ",", " ", 
          RowBox[{"erg", " ", "=", " ", "True"}]}], "]"}]}]}], "]"}], ";", 
     " ", "erg"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.606135365463459*^9, 3.6061353686302648`*^9}, {
