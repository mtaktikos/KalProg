     RowBox[{"Julian", "[", 
      RowBox[{"1444", ",", "5", ",", "31"}], "]"}], ",", "Gregorian"}], "]"}],
    ",", 
   RowBox[{"ConvertDateTo", "[", 
    RowBox[{
     RowBox[{"Julian", "[", 
      RowBox[{"1444", ",", "11", ",", "25"}], "]"}], ",", "Gregorian"}], 
    "]"}]}], "}"}]], "Input",ExpressionUUID->"3fe44d29-361c-4bd5-9130-\
