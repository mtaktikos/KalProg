Cell[BoxData[{
 RowBox[{
  RowBox[{"separation", "[", 
   RowBox[{"body1_", ",", " ", "body2_", ",", " ", "date_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "eph1", ",", "eph2", ",", "dec1", ",", "dec2", ",", "RA1", ",", "RA2"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"eph1", "=", 
      RowBox[{"Ephemeris", "[", 
       RowBox[{"body1", ",", " ", "date"}], "]"}]}], ";", 
     RowBox[{"RA1", "=", 
      RowBox[{
       RowBox[{"eph1", "[", 
        RowBox[{"[", 
         RowBox[{"5", ",", "1"}], "]"}], "]"}], " ", "Degree"}]}], ";", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"dec1", "=", 
      RowBox[{
       RowBox[{"eph1", "[", 
        RowBox[{"[", 
         RowBox[{"4", ",", "2"}], "]"}], "]"}], "Degree"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eph2", "=", 
      RowBox[{"Ephemeris", "[", 
       RowBox[{"body2", ",", "date"}], "]"}]}], ";", " ", 
     RowBox[{"RA2", "=", 
      RowBox[{
       RowBox[{"eph2", "[", 
        RowBox[{"[", 
         RowBox[{"5", ",", "1"}], "]"}], "]"}], " ", "Degree"}]}], ";", " ", 
     RowBox[{"dec2", "=", 
      RowBox[{
       RowBox[{"eph2", "[", 
        RowBox[{"[", 
         RowBox[{"4", ",", "2"}], "]"}], "]"}], "Degree"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"N", "[", 
      RowBox[{"ArcCos", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "dec1", "]"}], "*", 
         RowBox[{"Sin", "[", "dec2", "]"}]}], "+", 
        RowBox[{
         RowBox[{"Cos", "[", "dec1", "]"}], "*", 
         RowBox[{"Cos", "[", "dec2", "]"}], "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"RA1", "-", "RA2"}], "]"}]}]}], "]"}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{" "}]}], "Input",ExpressionUUID->"fb5914b6-d07d-4eee-95bf-\
315b7c3b3e83"],

