Cell["29. Juni 158 \t12:00 \t0.63 \tNH \t1778947.0", "Text",ExpressionUUID->"1a5a33ff-7505-46c7-a993-b74ab7a20fc4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Unser", " ", "Versuch"}], ",", " ", 
    RowBox[{"wo", " ", 
     RowBox[{"evt", ".", " ", "noch"}], " ", "weggefiltert", " ", "werden", 
     " ", 
     RowBox[{"mu\[SZ]", " ", ":"}]}]}], " ", "*)"}]], "Input",ExpressionUUID->
  "6752437d-1551-420b-974b-89c577e3afc6"],
 "\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{"sSunJupi", "[", "year_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"akt", "=", 
        RowBox[{"Gregorian", "[", 
         RowBox[{
          RowBox[{"year", "-", "1"}], ",", "12", ",", "31"}], "]"}]}], ",", 
       "aktl", ",", " ", "akth"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"akt", "=", 
         RowBox[{"DaysPlusC", "[", 
          RowBox[{"akt", ",", "1"}], "]"}]}], ";", " ", 
        RowBox[{"aktl", " ", "=", " ", 
         RowBox[{"akt", " ", "/.", " ", 
          RowBox[{"Gregorian", " ", "\[Rule]", " ", "List"}]}]}], ";", "  ", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"akth", " ", "=", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"aktl", ",", 
              RowBox[{"{", 
               RowBox[{"h", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Separation", "[", 
                  RowBox[{"Jupiter", ",", "Moon", ",", "akth"}], "]"}], "/", 
                 "Degree"}], "  ", "<", " ", "1.9"}], ")"}], " ", "&&", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Separation", "[", 
                  RowBox[{"Jupiter", ",", "Sun", ",", "akth"}], "]"}], "/", 
                 "Degree"}], "  ", ">", "  ", "169.0"}], ")"}]}], ",", " ", 
             RowBox[{"Print", "[", "akth", "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"h", ",", "0", ",", "18", ",", "6"}], "}"}]}], "]"}]}], 
       ",", " ", 
       RowBox[{"{", "365", "}"}]}], "]"}]}], "]"}]}]], "Input",ExpressionUUID->
  "b12dd90d-d5cc-48ca-b762-ac57d8a6bedc"]
}], "Text",ExpressionUUID->"4880c0a3-3961-4b6d-9d00-43e50f1b63d6"],

Cell[TextData[Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"sSunJupi", "[", "j", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"j", ",", "147", ",", "158"}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"8119b2c4-80db-4ffa-8bb9-63f501efb566"]], \
"Text",ExpressionUUID->"e6d8caa9-99b8-456d-bae6-698bbd85e167"],

