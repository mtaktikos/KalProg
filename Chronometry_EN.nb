Cell[TextData[{
 "You can also find the equator coordinates of a star. The syntax for \
specifying a star name is to use: ",
 StyleBox["star",
  FontFamily->"Courier",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[".",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 StyleBox["constellation",
  FontFamily->"Courier",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". For example:"
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"fcb570bf-8ff4-4c13-8b5d-2cd2d5edf9fb"],

