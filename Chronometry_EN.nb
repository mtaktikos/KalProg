Cell[BoxData[
 RowBox[{
  RowBox[{"eclipseMagnitude", "[", 
   RowBox[{"time_", ",", " ", "ort_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "suneph", ",", " ", "mooneph", ",", "sunRAdeg", ",", " ", "sunDecdeg", 
      ",", " ", "moonRAdeg", " ", ",", "moonDecdeg", " ", ",", " ", 
      "sunDistancekm", ",", " ", "moonDistancekm", ",", " ", "sunRA", ",", 
      " ", "moonRA", ",", " ", "sunDec", ",", " ", "moonDec", ",", " ", 
      "moonDectopo", ",", " ", "sunDir", ",", " ", "moonDir", ",", " ", "d", 
      ",", " ", "sunAngularRadius", ",", " ", "moonAngularRadius", ",", 
      "latdeg", ",", "londeg", ",", " ", "lat", ",", "lon", ",", " ", 
      "parallax", ",", " ", "magnitude"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"latdeg", "=", 
      RowBox[{"ort", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
     RowBox[{"londeg", "=", 
      RowBox[{"ort", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"suneph", "=", 
      RowBox[{"Ephemeris", "[", 
       RowBox[{"Sun", ",", " ", "time"}], "]"}]}], ";", " ", 
     RowBox[{"mooneph", " ", "=", " ", 
      RowBox[{"Ephemeris", "[", 
       RowBox[{"Moon", ",", " ", "time"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sunRAdeg", "=", 
      RowBox[{"suneph", "[", 
       RowBox[{"[", 
        RowBox[{"5", ",", "1"}], "]"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"sunDecdeg", " ", "=", " ", 
      RowBox[{"suneph", "[", 
       RowBox[{"[", 
        RowBox[{"4", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"moonRAdeg", " ", "=", " ", 
      RowBox[{"mooneph", "[", 
       RowBox[{"[", 
        RowBox[{"5", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"moonDecdeg", " ", "=", " ", 
      RowBox[{"mooneph", "[", 
       RowBox[{"[", 
        RowBox[{"4", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sunDistancekm", " ", "=", " ", 
      RowBox[{
       RowBox[{"suneph", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", "2"}], "]"}], "]"}], "*", "149597871"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"moonDistancekm", " ", "=", " ", 
      RowBox[{
       RowBox[{"mooneph", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", "2"}], "]"}], "]"}], "*", "149597871"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sunRA", ",", " ", "moonRA", ",", " ", "sunDec", ",", " ", "moonDec", 
        ",", " ", "lat", ",", " ", "lon"}], "}"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "sunRAdeg", ",", " ", "moonRAdeg", ",", " ", "sunDecdeg", ",", " ", 
         "moonDecdeg", ",", " ", "latdeg", ",", " ", "londeg"}], "}"}], "*", 
       "Degree"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"parallax", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"6371", "/", "moonDistancekm"}], ")"}], "*", 
       RowBox[{"Cos", "[", "lat", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"moonDectopo", "=", 
      RowBox[{"moonDec", " ", "-", " ", 
       RowBox[{"parallax", "*", "Degree"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sunDir", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "sunDec", "]"}], " ", 
         RowBox[{"Cos", "[", "sunRA", "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "sunDec", "]"}], " ", 
         RowBox[{"Sin", "[", "sunRA", "]"}]}], ",", " ", 
        RowBox[{"Sin", "[", "sunDec", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"moonDir", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "moonDectopo", "]"}], " ", 
         RowBox[{"Cos", "[", "moonRA", "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "moonDectopo", "]"}], " ", 
         RowBox[{"Sin", "[", "moonRA", "]"}]}], ",", " ", 
        RowBox[{"Sin", "[", "moonDectopo", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d", " ", "=", " ", 
      RowBox[{"ArcCos", "[", 
       RowBox[{"sunDir", " ", ".", " ", "moonDir"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sunAngularRadius", " ", "=", " ", 
      RowBox[{"ArcSin", "[", 
       RowBox[{"696340", "/", "sunDistancekm"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"moonAngularRadius", " ", "=", " ", 
      RowBox[{"ArcSin", "[", 
       RowBox[{"1737.4", "/", "moonDistancekm"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"magnitude", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "sunAngularRadius", " ", "+", " ", "moonAngularRadius", " ", "-", 
         "d"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "sunAngularRadius"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", "magnitude"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->
  "In[144]:=",ExpressionUUID->"0d83027f-ccac-6144-ae1b-f83606882ea6"],

