Cell["\<\
Die Funktion sofisichtbar[sofi_, ort_] gibt 0 aus, wenn sofi in ort nicht \
sichtbar war, eine 1, wenn sie partiell sichtbar war, and eine 2, wenn sogar \
die totale Phase einer totalen Sofi sichtbar war.\
\>", "Text",ExpressionUUID->"a9cc6d8c-15f8-e54d-9ce5-567fef302f0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"akt", ",", "sichtbar"}], "}"}], ",", 
    RowBox[{
     RowBox[{"akt", "=", 
      RowBox[{
       RowBox[{"SonnenfinsternisAlternate", "[", "1999", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"sichtbar", " ", "=", " ", 
      RowBox[{"sofisichtbar", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SonnenfinsternisAlternate", "[", "1999", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"Hamburg", "[", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"sichtbar", "==", "0"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Die Sofi \>\"", ",", "akt", ",", 
         "\"\< war in Hamburg unsichtbar\>\""}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"sichtbar", " ", "==", " ", "1"}], ",", " ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Von der Sofi \>\"", ",", "akt", ",", 
         "\"\< war in Hamburg nur eine partielle Sonnenabdeckung \
sichtbar\>\""}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"sichtbar", " ", "==", "2"}], ",", " ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Die totale Phase der Sofi \>\"", ",", "akt", ",", 
         "\"\< war in Hamburg isichtbar\>\""}], "]"}]}], "]"}]}]}], "]"}], 
  " "}]], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"876030a9-327f-1041-b831-d283543f1b76"],

