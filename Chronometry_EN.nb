Cell["\<\
Ein erhaltenes griechisches Horoskop spricht von einer Spikaabdeckung durch \
den Mond im 36. years der ersten \"Kallippischen Periode\", konkreter am \
Datum  15. Elaphebolion (griechisch) bzw. 5 Tybi (\[ADoubleDot]gyptisch). Da \
fast jede griechische Region ihre eigenen Kalenderberechnungen kannte, fiel \
der \"15. Elaphebolion\" praktisch allerorts auf einen verschiedenen Tag, so \
da\[SZ] das Horoskop der Genauigkit wegen den allgemeineren \
\[ADoubleDot]gyptischen Kalender zu Hilfe nahm.
Kallippische Perioden umfassen 76 \[ADoubleDot]gyptische Jahre, wobei das \
erste year der ersten Kallipischen Periode auf das \[ADoubleDot]gyptische \
Jahr 418 f\[ADoubleDot]llt.
Somit k\[ODoubleDot]nnen wir eine einfache Funktion Kallippisch[periode_, \
jahr_] bauen, die das entsprechende \[ADoubleDot]gyptische year errechnet:\
\>", "Text",ExpressionUUID->"bf2ed824-d1b1-45c8-b76f-7765ea41c774"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Kallippisch", "[", 
   RowBox[{"periode_", ",", " ", "jahr_"}], "]"}], ":=", " ", 
  RowBox[{"418", " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"periode", "-", "1"}], ")"}], "*", "76"}], " ", "+", " ", 
   "jahr"}]}]], "Input",
 CellChangeTimes->{{3.451477857734375*^9, 3.451477877421875*^9}, {
  3.451478870796875*^9, 3.451478886234375*^9}, {3.451478920015625*^9, 
  3.451478948453125*^9}, {3.451479148375*^9, 
  3.45147914953125*^9}},ExpressionUUID->"b6a98b68-e5e8-470f-b080-\
6fa21f4a3542"],

Cell["\<\
Auf welches Datum fiel also die beschriebene Spikaabdeckung? Das \
