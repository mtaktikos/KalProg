Cell[BoxData[
 StyleBox["\<\"Coordinates[object, date] returns the x,y,z coordinates in \
Astronomical Units of the object (a planet or a star, or Sun, Moon or \
asteroid) on the given date. If date is omitted the current Date[] is used.\"\
\>", "MSG"]], "Print", "PrintUsage",
 CellChangeTimes->{3.6015534684697065`*^9},
 CellTags->
  "Info3601557068-3591912",ExpressionUUID->"77aa925b-dd46-4a26-b4ce-\
27d3bf00d2ad"]
}, Open  ]],

