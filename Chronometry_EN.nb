Cell[TextData[StyleBox["Steine der Macht, Bd. 4: \:201eDas hier bedeutet \
Sonne Opposition Mond and sagt aus, da\[SZ] es eine Zeit des Vollmondes sein \
muss. Den gibt es aber jeden month einmal. Dann steht direkt an der Sonne der \
Jupiter, was jedes year einmal vorkommt and daher noch nicht als genaue \
Datumsangabe dienen kann. Der Saturn steht im Trigon zur Sonne, and das ist \
in Verbindung mit dem Jupiter schon eine sehr pr\[ADoubleDot]zise Angabe. Die \
beiden Planeten Jupiter and Saturn hat im \[UDoubleDot]rigen der italienische \
Gelehrte Galileo im year 1610 entdeckt. Seitdem hat man fr\[UDoubleDot]her \
gerne versteckte Zeitangaben mit diesen beiden Planeten gemacht.\
\[CloseCurlyDoubleQuote]\nWir beginnen mit dem 1.1.2005 and suchen etwa 15 \
Folgejahre ab, sagen wir: 5500 Tage. Da die Konjunktionen leichter zu \
errechnen sind als Vollmonde, werden sie in der If-Abfrage vorangestellt:",
 FontSize->16]], "Text",ExpressionUUID->"5a890831-416a-46a5-a0e4-\
d04d621126fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{
    RowBox[{"aktday", "=", " ", 
     RowBox[{"Gregorian", "[", 
      RowBox[{"2004", ",", "12", ",", "31"}], "]"}]}], ";", " ", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"aktday", "=", 
        RowBox[{"DaysPlusC", "[", 
         RowBox[{"aktday", ",", " ", "1"}], "]"}]}], ";", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"partielleConjQ", "[", 
           RowBox[{"Jupiter", ",", " ", "Sun", ",", " ", "aktday"}], "]"}], 
          " ", "&&", " ", 
          RowBox[{"trineQ", "[", 
           RowBox[{"Saturn", ",", " ", "Sun", ",", " ", "aktday"}], "]"}], 
          " ", "&&", " ", 
          RowBox[{"FullmoonQ", "[", "aktday", "]"}]}], ",", " ", 
         RowBox[{"Print", "[", "aktday", "]"}]}], "]"}]}], ",", " ", 
      RowBox[{"{", "5500", "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.6017332707578306`*^9, 3.6017332918334675`*^9}, 
   3.6061350827629623`*^9, 
   3.942068363830179*^9},ExpressionUUID->"a35734f2-cf92-4508-9732-\
ee19b7e39a74"],

