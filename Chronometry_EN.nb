Cell["\<\
Wir \[UDoubleDot]berpr\[UDoubleDot]fen alle Daten von 1600 bis 2100, in denen \
Equinoktien and Solstices auf Vollmond fallen:\
\>", "Text",ExpressionUUID->"73228d66-f351-0240-beeb-c7a60148aae2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "es", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"es", " ", "=", " ", 
       RowBox[{"Map", "[", 
        RowBox[{"First", ",", 
         RowBox[{"EquiSol", "[", "j", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FullmoonQ", "[", 
           RowBox[{"es", "[", 
            RowBox[{"[", "jz", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"es", "[", 
            RowBox[{"[", "jz", "]"}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"jz", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2100", ",", "1600", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"1fae658b-99e6-554e-ab55-d3b34b927780"],

