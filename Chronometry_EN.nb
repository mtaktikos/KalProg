Cell[TextData[{
 StyleBox["7.1.3. Equator Coordinates command",
  FontVariations->{"Underline"->True}],
 "\nThese coordinates are useful in conjunction with Star charts."
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"cd6ad874-311c-483b-afdf-22eaa35a8de3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\"\<EquatorCoordinates\>\"", ",", 
   RowBox[{"LongForm", "\[Rule]", "False"}]}], "]"}]], "Input",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"d17b4e8a-5ce7-4640-9072-27668c2aed05"],

Cell[BoxData[
 StyleBox["\<\"EquatorCoordinates[object, date] returns the Ascension, \
Declination and Distance of the object (a planet or a star) on the given \
date. An example planet would be Mars, and an example star would be \
Alpha.Centaurus. EquatorCoordinates[horizoncoords, date] will convert the \
horizoncoords for the current location into equatorcoords. An example \
horizoncoords would be {Azimuth->270*Degree, Altitude->30*Degree}. If date is \
omitted the current Date[] is used.\"\>", "MSG"]], "Print", "PrintUsage",
 CellChangeTimes->{3.601553631021992*^9},
 CellTags->
  "Info3601557230-3591912",ExpressionUUID->"8dbeeedf-4331-4deb-a340-\
6e80bd924887"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox["EquatorCoordinates",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " command can be applied to objects like ",
 StyleBox["Mars",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Moon",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Io",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " (solar system objects), ",
 StyleBox["Sirius",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Alpha.Centaurus",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " (stars), ",
 StyleBox["Leo",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["UrsaMajor",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " (constellations), ",
 StyleBox["SouthCelestialPole",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Zenith",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " (special objects) etc."
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"8f40b45a-d2d3-45f1-bc73-20134143f504"],

Cell["Here are some basic examples:", "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"11f4483e-072d-4c0e-9725-528c6cc04732"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EquatorCoordinates", "[", 
  RowBox[{"Mars", ",", 
   RowBox[{"{", 
    RowBox[{"1993", ",", "11", ",", "17", ",", "3", ",", "20", ",", "0"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"76b821ab-d4b9-44b8-93d5-\
de810533b120"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Ascension", "\[Rule]", 
    RowBox[{"16.223786923075572`", " ", "Hour"}]}], ",", 
   RowBox[{"Declination", "\[Rule]", 
    RowBox[{"-", "0.3775658684539316`"}]}], ",", 
   RowBox[{"Distance", "\[Rule]", 
    RowBox[{"2.452506898676806`", " ", "AU"}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.6015536705836616`*^9},ExpressionUUID->"7f09d296-1e0e-4035-9e8e-\
b8d99f154cef"]
}, Open  ]],

