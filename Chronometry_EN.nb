Cell["\<\
Zuletzt wollen wir sog. Bluemoons finden, d.h. Monate, wo zweimal Vollmond \
auftaucht:\
\>", "Text",ExpressionUUID->"8b348182-ded6-4da5-bcc9-793049fcae0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bluemoonQ", "[", "year_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"Vollmond", "[", "year", "]"}], "]"}], ">", "12"}]}]], "Input",
 CellChangeTimes->{{3.417619762765625*^9, 
  3.4176197630625*^9}},ExpressionUUID->"3758c119-b74d-40e5-8889-8ecffddc7b15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"bluemoonQ", "[", "i", "]"}], ",", 
     RowBox[{"Print", "[", "i", "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "2000", ",", "2009"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.41642329175*^9, 
  3.41642329325*^9}},ExpressionUUID->"d495013b-13b6-4568-a435-f57c051b3f85"],

