Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", ",", "akt", ",", " ", "ang", ",", 
     RowBox[{"erg", "=", 
      RowBox[{"{", "}"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"akt", " ", "=", " ", 
        TagBox[
         StyleBox[
          RowBox[{"OldHinduLunar", "[", 
           RowBox[{"5115", ",", "2", ",", "False", ",", "tag"}], "]"}],
          ShowSpecialCharacters->False,
          ShowStringCharacters->True,
          NumberMarks->True],
         FullForm]}], ";", " ", 
       RowBox[{"d", "=", 
        RowBox[{"ToFixed", "[", 
         RowBox[{"ConvertDateTo", "[", 
          RowBox[{"akt", ",", " ", "Gregorian"}], "]"}], "]"}]}], ";", 
       RowBox[{"ang", "=", 
        RowBox[{"LunarPhase", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"180", "-", "ang"}], "]"}], "<", " ", "3"}], ",", 
