Cell[TextData[{
 "The above shows that the atmospherically refracted position of the ",
 StyleBox["Sun",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 " is almost exactly on the horizon at sunset, which is where it should be at \
that time."
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"98ca9219-492e-4841-b327-fc269e86e3e1"],

Cell[TextData[{
 StyleBox["7.1.5. The ",
  FontVariations->{"Underline"->True}],
 StyleBox["Elongation",
  FontFamily->"Courier",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox[" command ",
  FontVariations->{"Underline"->True}],
 "\nThis is useful for indirectly determining the Rising and Setting times of \
a planet relative to local Sunrise and Sunset."
}], "Text",
 ImageRegion->{{0, 1}, {0, 
  1}},ExpressionUUID->"2ae8af43-430e-4af4-b8c6-29c286b627ef"],

