     RowBox[{"Declination", "\[Rule]", 
      RowBox[{"30", " ", "\[Degree]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1993", ",", "11", ",", "17", ",", "3", ",", "20", ",", "0"}], 
